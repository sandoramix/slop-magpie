# ── shared (api + worker) ───────────────────────────────────────────────
# Existing Postgres instance. Add ?sslmode=require if it leaves the host.
DATABASE_URL=postgres://magpie:change-me@localhost:5432/magpie
# Public HTTPS origin of the API (used to build signed media URLs)
PUBLIC_BASE_URL=http://localhost:3000
# openssl rand -base64 48
MEDIA_SIGNING_SECRET=
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/media
LOG_LEVEL=info
# pretty (one readable line per event) | json
LOG_FORMAT=pretty

# ── api ─────────────────────────────────────────────────────────────────
PORT=3000
# Admin token: openssl rand -base64 48. Accounts get their own tokens from the app (Settings > Manage users).
API_TOKEN=
# Comma-separated web origins allowed by CORS (empty = none)
CORS_ORIGINS=
MEDIA_URL_TTL_SECONDS=3600
# true only behind a proxy that sets X-Forwarded-For (Coolify); see docs/deployment.md
TRUST_PROXY=false

# ── worker ──────────────────────────────────────────────────────────────
# Dir with per-source cookie files: <source-id>.txt (Netscape format)
COOKIES_DIR=./secrets/cookies
# Writable dir for sessions created by automatic login
SESSIONS_DIR=./secrets/sessions
# Optional: worker logs in itself (gallery-dl) and renews the session when it dies, so no instagram.txt upload.
# Use a secondary account without 2FA.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
WORKER_TMP_DIR=./tmp
WORKER_CONCURRENCY=1
MAX_VIDEO_MB=60
# hard cap per downloaded file
MAX_DOWNLOAD_MB=500
AUTO_ASSIGN_THRESHOLD=0.8

# ── s3 driver (later, Backblaze B2) ─────────────────────────────────────
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_BUCKET=magpie
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── mobile (apps/mobile/.env) — public, NEVER put secrets here ───────────
# EXPO_PUBLIC_DEFAULT_API_URL=https://magpie.example.com
