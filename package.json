{
  "name": "slop-magpie",
  "version": "1.4.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "lint": "turbo run lint && eslint scripts",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @magpie/db db:generate",
    "db:migrate": "pnpm --filter @magpie/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
